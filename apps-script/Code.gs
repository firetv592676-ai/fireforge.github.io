const CONFIG={APPS_FOLDER:'Apps',EXPLOIT_FOLDER:'Exploit',CATALOG_PATH:'data/catalog.json',ADMIN_PIN:'CHANGE_THIS_PIN'};
function doGet(){return HtmlService.createHtmlOutput(`<form style="font:16px system-ui;max-width:600px;margin:30px auto" id="f"><h1>FireForge Upload Center</h1><label>Type <select name="category"><option value="apps">App / APK</option><option value="exploit">Exploit / Security Research</option></select></label><p><input name="name" placeholder="Name of app or exploit" required></p><p><textarea name="description" placeholder="Description" required></textarea></p><p><input name="file" type="file" required></p><p><input name="pin" type="password" placeholder="Admin PIN" required></p><button>Upload</button><p id="r"></p></form><script>f.onsubmit=e=>{e.preventDefault();r.textContent='Uploading…';google.script.run.withSuccessHandler(x=>r.textContent=x).withFailureHandler(x=>r.textContent=x.message).processUpload(f)}</script>`)}
function processUpload(f){if(f.pin!==CONFIG.ADMIN_PIN)throw Error('Incorrect PIN');const cat=f.category==='apps'?'Apps':'Exploit';if(cat==='Apps'&&!/\.apk$/i.test(f.file.getName()))throw Error('Apps must be APK files');const folder=getFolder_(cat);const file=folder.createFile(f.file).setName(f.file.getName());file.setDescription(JSON.stringify({fireforgeName:f.name,description:f.description,category:f.category}));syncFireForge();return 'Upload successful';}
function syncFireForge(){const p=PropertiesService.getScriptProperties(),token=p.getProperty('GITHUB_TOKEN'),owner=p.getProperty('GITHUB_OWNER'),repo=p.getProperty('GITHUB_REPO'),branch=p.getProperty('GITHUB_BRANCH')||'main';if(!token||!owner||!repo)throw Error('Configure GitHub Script Properties first');const out=[];['Apps','Exploit'].forEach(folderName=>{const fs=getFolder_(folderName).getFiles();while(fs.hasNext()){const f=fs.next(),m=JSON.parse(f.getDescription()||'{}');out.push({driveId:f.getId(),name:m.fireforgeName||f.getName(),description:m.description||'',category:folderName==='Apps'?'apps':'exploit',type:folderName==='Apps'?'APK':'Security Research',size:f.getSize(),downloadUrl:`https://drive.google.com/file/d/${f.getId()}/view`});}});put_('data/catalog.json',JSON.stringify(out,null,2),token,owner,repo,branch);return `Synced ${out.length} items`;}
function getFolder_(n){const x=DriveApp.getFoldersByName(n);return x.hasNext()?x.next():DriveApp.createFolder(n)}function put_(path,text,token,owner,repo,branch){const url=`https://api.github.com/repos/${owner}/${repo}/contents/${path}`,h={Authorization:`Bearer ${token}`,Accept:'application/vnd.github+json'},old=UrlFetchApp.fetch(url+'?ref='+branch,{headers:h,muteHttpExceptions:true});const b=JSON.parse(old.getContentText()),body={message:'Update FireForge catalog',branch,content:Utilities.base64Encode(text)};if(b.sha)body.sha=b.sha;UrlFetchApp.fetch(url,{method:'put',headers:h,payload:JSON.stringify(body)});}function setupAutomation(){ScriptApp.newTrigger('syncFireForge').timeBased().everyMinutes(10).create()}function manualSync(){return syncFireForge()}
